[Unit]
Description=VPS Tools database and artifact backup
After=vps-tools-api.service
OnFailure=vps-tools-backup-alert.service

[Service]
Type=oneshot
User=vps-tools
Group=vps-tools
WorkingDirectory=/var/lib/vps-tools
EnvironmentFile=-/etc/vps-tools/backup.env
ExecStart=/usr/local/libexec/vps-tools/backup-systemd.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vps-tools
UMask=0077

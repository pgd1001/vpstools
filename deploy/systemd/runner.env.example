# Installed as /etc/vps-tools/runner.env, mode 0600.
API_URL=http://127.0.0.1:8080
JOB_DISPATCH=database
# For the JetStream notification bridge, set JOB_DISPATCH=jetstream and
# provide the same NATS settings in api.env and runner.env.
# NATS_URL=nats://127.0.0.1:4222
# NATS_STREAM=SVRTOOLS_JOBS
# NATS_SUBJECT=svrtools.jobs.available
# NATS_DURABLE=svrtools-runners
# NATS_MAX_DELIVER=5
# NATS_ACK_WAIT=30s
# NATS_DUPLICATE_WINDOW=2m
RUNNER_NAME=single-host-runner
RUNNER_HEALTH_ADDR=127.0.0.1:9091
VPS_RUNNER_TOKEN=replace-with-a-runner-token
SIMULATE=false
SSH_USER=svrtools
SSH_TARGET_HOST=127.0.0.1
SSH_TARGET_PORT=22
SSH_KNOWN_HOSTS=/etc/vps-tools/known_hosts
# SSH_PASSWORD=only-if-password-authentication-is required

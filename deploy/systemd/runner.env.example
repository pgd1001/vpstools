# Installed as /etc/vps-tools/runner.env, mode 0600.
API_URL=http://127.0.0.1:8080
JOB_DISPATCH=database
# For the JetStream notification bridge, set JOB_DISPATCH=jetstream and
# provide the same NATS settings in api.env and runner.env.
# NATS_URL=nats://127.0.0.1:4222
# NATS_STREAM=SVRTOOLS_JOBS
# NATS_SUBJECT=svrtools.jobs.available
# NATS_DURABLE=svrtools-runners
# NATS_MAX_DELIVER=5
# NATS_ACK_WAIT=30s
# NATS_DUPLICATE_WINDOW=2m
# Mandatory, and must be byte-identical to the value in api.env. The runner
# verifies every job against this key and refuses any job that does not match,
# so a mismatch shows up as refused jobs rather than silent execution.
JOB_SIGNING_KEY=replace-with-a-random-key-of-at-least-32-characters

RUNNER_NAME=single-host-runner
RUNNER_HEALTH_ADDR=127.0.0.1:9091
# Bootstrap credential from: vps runner registration-token. Registration
# exchanges it for a credential bound to this runner identity, which is what
# the job endpoints require.
VPS_RUNNER_TOKEN=replace-with-a-runner-registration-token
SIMULATE=false
# Fallback connection details, used only when a job does not carry its own.
SSH_USER=svrtools
SSH_TARGET_HOST=127.0.0.1
SSH_TARGET_PORT=22
# Per-server SSH credentials live in this directory, one file per credential
# reference, and never leave the runner host. Register a server with a matching
# --ssh-credential-ref and the runner will use the corresponding key:
#
#   /etc/vps-tools/ssh-credentials/web-prod             PEM private key
#   /etc/vps-tools/ssh-credentials/web-prod.passphrase  optional passphrase
#   /etc/vps-tools/ssh-credentials/web-prod.password    optional password
#
# The directory should be mode 0700 and owned by the runner user.
#
# Host identity is pinned per server by the control plane, not by a shared
# known_hosts file. Record each server's fingerprint at registration with:
#
#   ssh-keyscan -p <port> <host> | ssh-keygen -lf -
#
# A server with no recorded fingerprint or credential is refused rather than
# connected to unverified.
SSH_CREDENTIALS_DIR=/etc/vps-tools/ssh-credentials

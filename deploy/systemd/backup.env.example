# Installed as /etc/vps-tools/backup.env, mode 0600.
DATABASE_URL=/var/lib/vps-tools/svrtools.db
ARTIFACTS_DIR=/var/lib/vps-tools/data/artifacts
BACKUP_ROOT=/var/lib/vps-tools/backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=129600
# Required when the local artefact store uses a generated artifacts/.key.
# Use a separate protected secret, not the artefact key and not the backup disk.
BACKUP_ENCRYPTION_KEY=
# Optional protected mount or replicated destination. Keep it outside the
# VPS Tools data disk and apply separate retention or immutability controls.
BACKUP_REPLICATION_DIR=

# Optional HTTPS endpoint for a simple failure notification. Leave empty to
# retain the failure in the systemd journal only.
VPS_BACKUP_ALERT_WEBHOOK=

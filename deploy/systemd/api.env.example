# Installed as /etc/vps-tools/api.env, mode 0600.
VPS_ENV=production
API_PORT=8080
DATABASE_DRIVER=sqlite
DATABASE_URL=/var/lib/vps-tools/svrtools.db
POSTGRES_RLS=false
ARTIFACT_STORE=local
ARTIFACTS_DIR=/var/lib/vps-tools/data/artifacts
JOB_DISPATCH=database
# For the JetStream notification bridge, set JOB_DISPATCH=jetstream and
# provide the same NATS settings in api.env and runner.env.
# NATS_URL=nats://127.0.0.1:4222
# NATS_STREAM=SVRTOOLS_JOBS
# NATS_SUBJECT=svrtools.jobs.available
# NATS_DURABLE=svrtools-runners
# NATS_MAX_DELIVER=5
# NATS_ACK_WAIT=30s
# NATS_DUPLICATE_WINDOW=2m
SCHEDULER=embedded
EVENT_BUS=disabled

# Production mode rejects development identity headers. Configure the shared
# secret used by the trusted web proxy, then provision matching OIDC users.
VPS_DEV_AUTH=false
VPS_WEB_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional bounded read-only AI analysis. Keep this disabled unless the
# provider's data handling is approved. A local endpoint keeps operations data
# inside the deployment.
# AI_PROVIDER=openai-compatible
# AI_ENDPOINT=http://127.0.0.1:11434/v1
# AI_MODEL=your-local-model

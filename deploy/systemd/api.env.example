# Installed as /etc/vps-tools/api.env, mode 0600.
VPS_ENV=production
API_PORT=8080
DATABASE_DRIVER=sqlite
DATABASE_URL=/var/lib/vps-tools/svrtools.db
ARTIFACT_STORE=local
ARTIFACTS_DIR=/var/lib/vps-tools/data/artifacts
JOB_DISPATCH=database
SCHEDULER=embedded
EVENT_BUS=disabled

# Production mode rejects development identity headers. Configure the shared
# secret used by the trusted web proxy, then provision matching OIDC users.
VPS_DEV_AUTH=false
VPS_WEB_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-characters

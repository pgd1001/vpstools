[Unit]
Description=VPS Tools API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=vps-tools
Group=vps-tools
WorkingDirectory=/var/lib/vps-tools
EnvironmentFile=-/etc/vps-tools/api.env
ExecStart=/opt/vps-tools/current/api
ExecStartPost=/usr/local/libexec/vps-tools/healthcheck.sh --api-only
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vps-tools
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
